{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "noEmit": false,
    "outDir": "./doopa",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": [
    "src"
  ]
}
